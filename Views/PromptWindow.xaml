<Window x:Class="CSVEditor.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV Editor"
        Width="420"
        Background="{DynamicResource Brush.Bg}"
        FontFamily="{DynamicResource Font.Ui}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Border Padding="22,20" Background="{DynamicResource Brush.Bg}">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="{StaticResource Font.Size.Xl}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}"
                       Text="标题" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="FirstLabel"
                           Grid.Row="0"
                           Grid.Column="0"
                           Style="{StaticResource FieldLabel}"
                           Text="名称" />
                <TextBox x:Name="FirstBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         KeyDown="Box_KeyDown"
                         MinWidth="240" />

                <StackPanel x:Name="SecondRow"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                    <TextBlock x:Name="SecondLabel"
                               Margin="0,12,7,0"
                               Style="{StaticResource FieldLabel}"
                               Text="列号" />
                    <TextBox x:Name="SecondBox"
                             Width="120"
                             Margin="0,12,0,0"
                             HorizontalAlignment="Left"
                             KeyDown="Box_KeyDown"
                             TextChanged="SecondBox_TextChanged" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,22,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Click="Cancel_Click"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource Button.Subtle}" />
                <Button x:Name="ConfirmButton"
                        Margin="8,0,0,0"
                        Click="Confirm_Click"
                        Content="确定"
                        IsDefault="True"
                        Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
